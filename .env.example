DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary — private raw PDF document storage (server-side only, never NEXT_PUBLIC).
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Gemini — server-side structured document extraction (server-side only, never NEXT_PUBLIC).
# Free-tier key from Google AI Studio; apply "Restrict to Gemini API only".
# No billing account or payment card is required for the free tier.
GEMINI_API_KEY="your-gemini-api-key"
